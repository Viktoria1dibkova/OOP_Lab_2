<Window x:Class="Lab_1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Interface" Height="450" Width="800" Background="{Binding WindowBackground}" Foreground="{Binding WindowForeground}" FontFamily="{Binding CurrentFontFamily}">
    <TabControl Margin="10" FontSize="{Binding FontSize}" Background="{Binding WindowBackground}" Foreground="{Binding WindowForeground}">
        <TabItem Header="{Binding TabMain}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="10">
                    <GroupBox Header="{Binding GroupPersonalization}" Style="{StaticResource StandardGroupBoxStyle}">
                        <StackPanel Margin="5">
                            <TextBlock Text="{Binding TextTheme}" Margin="0,5,0,0"/>
                            <ComboBox Margin="0,5" SelectedValue="{Binding SelectedTheme, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Content">
                                <ComboBoxItem Content="Светлая тема"/>
                                <ComboBoxItem Content="Темная тема"/>
                            </ComboBox>

                            <TextBlock Text="Язык / Language / 언어:" Margin="0,10,0,0"/>
                            <ComboBox Margin="0,5" SelectedValue="{Binding SelectedLanguage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  SelectedValuePath="Content">
                                <ComboBoxItem Content="Русский"/>
                                <ComboBoxItem Content="English"/>
                                <ComboBoxItem Content="한국어"/>
                            </ComboBox>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Header="{Binding GroupFonts}" Style="{StaticResource StandardGroupBoxStyle}">
                        <StackPanel Margin="5">
                            <TextBlock Text="{Binding FontType_}" Margin="0,5,0,0"/>
                            <ComboBox Margin="0,5" SelectedValue="{Binding SelectedFont, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Content">
                                <ComboBoxItem Content="Arial"/>
                                <ComboBoxItem Content="Times New Roman"/>
                                <ComboBoxItem Content="Segoe UI"/>
                            </ComboBox>

                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="{Binding TextFontSize}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding FontSize}" VerticalAlignment="Center" Margin="5,0" FontWeight="Bold" Foreground="{StaticResource PrimaryColorBrush}"/>
                                <Slider Width="200" Minimum="8" Maximum="32" Value="{Binding FontSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="{Binding TabPalette}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="10" >

                    <GroupBox Header="Текущая тема" FontSize="12"
                              Style="{StaticResource StandardGroupBoxStyle}">
                        <TextBlock Text="{Binding SelectedTheme}" FontSize="14"
                                   FontWeight="Bold" Margin="10"/>
                    </GroupBox>

                    <GroupBox Header="Системные цвета" FontSize="12"
                              Style="{StaticResource StandardGroupBoxStyle}">
                        <StackPanel Margin="10">
                            <StackPanel Orientation="Horizontal" Margin="0,5">
                                <Rectangle Width="30" Height="30" Margin="0,0,10,0" Fill="{StaticResource PrimaryColorBrush}"/>
                                <TextBlock Text="PrimaryColorBrush - основной" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,5">
                                <Rectangle Width="30" Height="30" Margin="0,0,10,0" Fill="{StaticResource AccentColorBrush}"/>
                                <TextBlock Text="AccentColorBrush - акцентный" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,5">
                                <Rectangle Width="30" Height="30" Margin="0,0,10,0" Fill="{StaticResource SuccessColorBrush}"/>
                                <TextBlock Text="SuccessColorBrush - успех" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,5">
                                <Rectangle Width="30" Height="30" Margin="0,0,10,0" Fill="{StaticResource DangerColorBrush}"/>
                                <TextBlock Text="DangerColorBrush - ошибка" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,5">
                                <Rectangle Width="30" Height="30" Margin="0,0,10,0" Fill="{StaticResource InfoColorBrush}"/>
                                <TextBlock Text="InfoColorBrush - информация" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Таблица оттенков (ObservableCollection из Library)"
                              Style="{StaticResource StandardGroupBoxStyle}">
                        <StackPanel Margin="10">
                            <TextBlock Text="Основной цвет (бордовый)" FontWeight="Bold" Margin="0,10,0,5"/>
                            <DataGrid Style="{StaticResource StandardDataGridStyle}" Height="220"
                                      AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                      ItemsSource="{Binding BurgundyColors}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Цвет" Width="100" Binding="{Binding ColorHex}"/>
                                    <DataGridTextColumn Header="RGB код" Width="150" Binding="{Binding RGB}"/>
                                    <DataGridTextColumn Header="Наименование" Width="*" Binding="{Binding Name}"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <TextBlock Text="Акцентный цвет (синий)" FontWeight="Bold" Margin="0,10,0,5"/>
                            <DataGrid Style="{StaticResource StandardDataGridStyle}" Height="220"
                                      AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                      ItemsSource="{Binding BlueColors}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Цвет" Width="100" Binding="{Binding ColorHex}"/>
                                    <DataGridTextColumn Header="RGB код" Width="150" Binding="{Binding RGB}"/>
                                    <DataGridTextColumn Header="Наименование" Width="*" Binding="{Binding Name}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </GroupBox>

                </StackPanel>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="{Binding TabControls}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="10">

                    <Expander Header="Кнопки (стили из Resource)" IsExpanded="True" Margin="0,0,0,10">
                        <StackPanel Margin="10" Orientation="Horizontal">
                            <Button Content="Primary"  Width="120" Style="{StaticResource PrimaryButtonStyle}"/>
                            <Button Content="Success"  Width="120" Style="{StaticResource SuccessButtonStyle}"/>
                            <Button Content="Danger"   Width="120" Style="{StaticResource DangerButtonStyle}"/>
                            <Button Content="Disabled" Width="120" IsEnabled="False"
                                    Style="{StaticResource PrimaryButtonStyle}"/>
                        </StackPanel>
                    </Expander>

                    <Expander Header="Текстовые поля" IsExpanded="True" Margin="0,0,0,10">
                        <StackPanel Margin="10" Width="350" HorizontalAlignment="Left">
                            <TextBox Text="TextBox со стилем из библиотеки"
                                     Style="{StaticResource StandardTextBoxStyle}"/>
                            <TextBox Text="Кликни: триггер IsFocused подсветит границу"
                                     Style="{StaticResource StandardTextBoxStyle}"/>
                            <PasswordBox Password="12345" Margin="0,5" Padding="5"/>
                            <RichTextBox Height="60" Margin="0,5">
                                <FlowDocument>
                                    <Paragraph>RichTextBox — форматированный текст</Paragraph>
                                </FlowDocument>
                            </RichTextBox>
                        </StackPanel>
                    </Expander>

                    <Expander Header="Текстовые элементы" IsExpanded="True" Margin="0,0,0,10">
                        <StackPanel Margin="10">
                            <Label Content="Заголовок 1" FontSize="24" FontWeight="Bold"/>
                            <Label Content="Заголовок 2" FontSize="20" FontWeight="Bold"/>
                            <Label Content="Заголовок 3" FontSize="16" FontWeight="Bold"/>
                            <TextBlock Text="Обычный текст" Margin="0,5"/>
                            <TextBlock Text="Подпись (мелкий текст)" FontSize="10"
                                       Foreground="{StaticResource DisabledColorBrush}" Margin="0,5"/>
                        </StackPanel>
                    </Expander>

                    <Expander Header="Списки и таблицы" IsExpanded="False" Margin="0,0,0,10">
                        <StackPanel Margin="10">
                            <ListBox Width="220" Height="90" HorizontalAlignment="Left" Margin="0,5">
                                <ListBoxItem Content="Элемент 1"/>
                                <ListBoxItem Content="Элемент 2"/>
                                <ListBoxItem Content="Элемент 3"/>
                            </ListBox>
                            <TreeView Width="220" Height="90" HorizontalAlignment="Left" Margin="0,5">
                                <TreeViewItem Header="Корень">
                                    <TreeViewItem Header="Дочерний 1"/>
                                    <TreeViewItem Header="Дочерний 2"/>
                                </TreeViewItem>
                            </TreeView>
                            <DataGrid Width="320" Height="100" HorizontalAlignment="Left" Margin="0,5"
                                      Style="{StaticResource StandardDataGridStyle}"
                                      AutoGenerateColumns="False" CanUserAddRows="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Имя" Width="*"/>
                                    <DataGridTextColumn Header="Значение" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Expander>

                    <Expander Header="Прогресс-бар и подсказки" IsExpanded="False" Margin="0,0,0,10">
                        <StackPanel Margin="10">
                            <ProgressBar Height="20" Width="300" HorizontalAlignment="Left"
                                         Margin="0,5" IsIndeterminate="True"/>
                            <Button Content="Наведи на меня" Width="200" HorizontalAlignment="Left"
                                    Margin="0,5" Style="{StaticResource PrimaryButtonStyle}"
                                    ToolTip="Это всплывающая подсказка!"/>
                            <TextBlock Text="Текст с подсказкой" Margin="0,5"
                                       ToolTip="Подсказка для текста"/>
                        </StackPanel>
                    </Expander>

                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="{Binding Containers_}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="10">
                    <GroupBox Header="StackPanel - элементы располагаются вертикально или горизонтально" Margin="0,0,0,10">
                        <StackPanel Margin="10">
                            <Rectangle Fill="Red" Width="100" Height="30" Margin="5"/>
                            <Rectangle Fill="Green" Width="100" Height="30" Margin="5"/>
                            <Rectangle Fill="Blue" Width="100" Height="30" Margin="5"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="WrapPanel - элементы переносятся на новую строку" Margin="0,0,0,10">
                        <WrapPanel Margin="10">
                            <Rectangle Fill="Red" Width="100" Height="30" Margin="5"/>
                            <Rectangle Fill="Green" Width="100" Height="30" Margin="5"/>
                            <Rectangle Fill="Blue" Width="100" Height="30" Margin="5"/>
                            <Rectangle Fill="Yellow" Width="100" Height="30" Margin="5"/>
                            <Rectangle Fill="Purple" Width="100" Height="30" Margin="5"/>
                        </WrapPanel>
                    </GroupBox>

                    <GroupBox Header="Grid - элементы располагаются по сетке" Margin="0,0,0,10">
                        <Grid Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Rectangle Fill="Red" Grid.Row="0" Grid.Column="0" Height="50" Margin="5"/>
                            <Rectangle Fill="Green" Grid.Row="0" Grid.Column="1" Height="50" Margin="5"/>
                            <Rectangle Fill="Blue" Grid.Row="1" Grid.Column="0" Height="50" Margin="5"/>
                            <Rectangle Fill="Yellow" Grid.Row="1" Grid.Column="1" Height="50" Margin="5"/>
                        </Grid>
                    </GroupBox>

                    <GroupBox Header="DockPanel - элементы прижимаются к краям" Margin="0,0,0,10">
                        <DockPanel Margin="10" Height="200">
                            <Rectangle Fill="Red" DockPanel.Dock="Top" Height="40" Margin="5"/>
                            <Rectangle Fill="Green" DockPanel.Dock="Left" Width="80" Margin="5"/>
                            <Rectangle Fill="Blue" DockPanel.Dock="Right" Width="80" Margin="5"/>
                            <Rectangle Fill="Yellow" Margin="5"/>
                        </DockPanel>
                    </GroupBox>

                    <GroupBox Header="Canvas - абсолютное позиционирование" Margin="0,0,0,10">
                        <Canvas Margin="10" Height="200">
                            <Rectangle Fill="Red" Canvas.Left="10" Canvas.Top="10" Width="100" Height="50"/>
                            <Rectangle Fill="Green" Canvas.Left="150" Canvas.Top="30" Width="100" Height="50"/>
                            <Rectangle Fill="Blue" Canvas.Left="80" Canvas.Top="120" Width="100" Height="50"/>
                        </Canvas>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="{Binding TabData}">
            <StackPanel Margin="10">

                <ToolBar Margin="0,0,0,10">
                    <Button Content="Добавить"  Command="{Binding AddCommand}"    Style="{StaticResource SuccessButtonStyle}"/>
                    <Button Content="Изменить" Command="{Binding EditCommand}"   Style="{StaticResource PrimaryButtonStyle}"/>
                    <Button Content="Удалить"   Command="{Binding DeleteCommand}" Style="{StaticResource DangerButtonStyle}"/>
                    <Separator/>
                    <Button Content="Копировать" Command="{Binding CopyCommand}" Style="{StaticResource PrimaryButtonStyle}"/>
                    <Button Content="Вставить"   Command="{Binding PasteCommand}" Style="{StaticResource PrimaryButtonStyle}"/>
                </ToolBar>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <GroupBox Grid.Column="0" Header="Исходная таблица" Margin="0,0,5,0"
                              Style="{StaticResource StandardGroupBoxStyle}">
                        <DataGrid Style="{StaticResource StandardDataGridStyle}" ItemsSource="{Binding SourceTable}" SelectedItem="{Binding SelectedSourceItem, Mode=TwoWay}"
                                  AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Имя" Width="*" Binding="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <DataGridTextColumn Header="Значение" Width="*" Binding="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>


                    <GroupBox Grid.Column="2" Header="Целевая таблица (результат вставки)" Margin="5,0,0,0"
                              Style="{StaticResource StandardGroupBoxStyle}">
                        <DataGrid Style="{StaticResource StandardDataGridStyle}" ItemsSource="{Binding TargetTable}"
                                  AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Имя" Width="*" Binding="{Binding Name}"/>
                                <DataGridTextColumn Header="Значение" Width="*" Binding="{Binding Value}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>
                </Grid>

            </StackPanel>
        </TabItem>

        <TabItem Header="{Binding TabBindings}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20">
                    <TextBlock Text="Демонстрация режимов Binding Mode и UpdateSourceTrigger"
                               FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="OneWay (только VM → View):" VerticalAlignment="Center" Margin="5"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding FontSize, Mode=OneWay, StringFormat='Размер шрифта: {0}'}"
                                   VerticalAlignment="Center" Margin="5" FontSize="16"
                                   Foreground="{StaticResource PrimaryColorBrush}"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="TwoWay + PropertyChanged:" VerticalAlignment="Center" Margin="5"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SelectedTheme, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource StandardTextBoxStyle}" Margin="5"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="TwoWay + LostFocus (по умолчанию):" VerticalAlignment="Center" Margin="5"/>
                        <TextBox Grid.Row="2" Grid.Column="1"
                                 Text="{Binding SelectedTheme, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                 Style="{StaticResource StandardTextBoxStyle}" Margin="5"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="OneWayToSource (только View → VM):"
                                   VerticalAlignment="Center" Margin="5"/>
                        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
                            <TextBox Width="260"
                             Text="{Binding SourceOnlyText, Mode=OneWayToSource, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource StandardTextBoxStyle}" Margin="5"/>
                            <TextBlock Text="{Binding SourceOnlyText, StringFormat='→ дошло до VM: «{0}»'}" VerticalAlignment="Center" Margin="5" Foreground="{StaticResource InfoColorBrush}"/>
                        </StackPanel>


                        <TextBlock Grid.Row="4" Grid.Column="0" Text="OneTime (только при инициализации):"
                                   VerticalAlignment="Center" Margin="5"/>
                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding SelectedTheme, Mode=OneTime}" Style="{StaticResource StandardTextBoxStyle}" Margin="5"/>
                    </Grid>

                    <GroupBox Header="Результат привязки (SelectedTheme)" Margin="0,20,0,0"
                              Style="{StaticResource StandardGroupBoxStyle}">
                        <StackPanel>
                            <TextBlock Text="Текущее значение свойства в ViewModel:" FontWeight="Bold"/>
                            <TextBlock Text="{Binding SelectedTheme}" FontSize="20" Foreground="{StaticResource SuccessColorBrush}" Margin="0,5,0,0"/>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</Window>
