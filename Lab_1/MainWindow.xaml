<Window x:Class="Lab_1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="clr-namespace:CodingSeb.Localization.WPF;assembly=CodingSeb.Localization.WPF"
        mc:Ignorable="d"
        Title="{loc:Tr App_Title}" Height="450" Width="800" Background="{Binding WindowBackground}" Foreground="{Binding WindowForeground}" FontFamily="{Binding CurrentFontFamily}">
    <TabControl Margin="10" FontSize="{Binding FontSize}" Background="{Binding WindowBackground}" Foreground="{Binding WindowForeground}">
        <TabItem Header="{loc:Tr Tab_Main}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="10">
                    <GroupBox Header="{loc:Tr Group_Personalization}" Style="{StaticResource StandardGroupBoxStyle}">
                        <StackPanel Margin="5">
                            <TextBlock Text="{loc:Tr Label_Theme}" Margin="0,5,0,0"/>
                            <ComboBox Margin="0,5"  SelectedValuePath="Tag" SelectedValue="{Binding SelectedTheme, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                <ComboBoxItem Tag="Light" Content="{loc:Tr Theme_Light}"/>
                                <ComboBoxItem Tag="Dark"  Content="{loc:Tr Theme_Dark}"/>
                            </ComboBox>

                            <TextBlock Text="{loc:Tr Label_Language}" Margin="0,10,0,0"/>
                            <ComboBox Margin="0,5" SelectedValue="{Binding SelectedLanguage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  SelectedValuePath="Content">
                                <ComboBoxItem Content="Русский"/>
                                <ComboBoxItem Content="English"/>
                                <ComboBoxItem Content="한국어"/>
                            </ComboBox>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Header="{loc:Tr Group_Fonts}" Style="{StaticResource StandardGroupBoxStyle}">
                        <StackPanel Margin="5">
                            <TextBlock Text="{Binding FontType_}" Margin="0,5,0,0"/>
                            <ComboBox Margin="0,5" SelectedValue="{Binding SelectedFont, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Content">
                                <ComboBoxItem Content="Arial"/>
                                <ComboBoxItem Content="Times New Roman"/>
                                <ComboBoxItem Content="Segoe UI"/>
                            </ComboBox>

                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="{loc:Tr Label_FontSize}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding FontSize}" VerticalAlignment="Center" Margin="5,0" FontWeight="Bold" Foreground="{StaticResource PrimaryColorBrush}"/>
                                <Slider Width="200" Minimum="8" Maximum="32" Value="{Binding FontSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="{loc:Tr Tab_Palette}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="10" >

                    <GroupBox Header="{loc:Tr Group_CurrentTheme}" FontSize="12"
                              Style="{StaticResource StandardGroupBoxStyle}">
                        <TextBlock Text="{Binding SelectedTheme, Converter={loc:TrTextIdConverter TextIdStringFormat='Theme_{0}'}}" FontSize="14"
                                   FontWeight="Bold" Margin="10"/>
                    </GroupBox>

                    <GroupBox Header="{loc:Tr Group_SystemColors}" FontSize="12"
                              Style="{StaticResource StandardGroupBoxStyle}">
                        <StackPanel Margin="10">
                            <StackPanel Orientation="Horizontal" Margin="0,5">
                                <Rectangle Width="30" Height="30" Margin="0,0,10,0" Fill="{StaticResource PrimaryColorBrush}"/>
                                <TextBlock Text="{loc:Tr Color_Primary}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,5">
                                <Rectangle Width="30" Height="30" Margin="0,0,10,0" Fill="{StaticResource AccentColorBrush}"/>
                                <TextBlock Text="{loc:Tr Color_Accent}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,5">
                                <Rectangle Width="30" Height="30" Margin="0,0,10,0" Fill="{StaticResource SuccessColorBrush}"/>
                                <TextBlock Text="{loc:Tr Color_Success}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,5">
                                <Rectangle Width="30" Height="30" Margin="0,0,10,0" Fill="{StaticResource DangerColorBrush}"/>
                                <TextBlock Text="{loc:Tr Color_Danger}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,5">
                                <Rectangle Width="30" Height="30" Margin="0,0,10,0" Fill="{StaticResource InfoColorBrush}"/>
                                <TextBlock Text="{loc:Tr Color_Info}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="{loc:Tr Group_ShadesTable}"
                              Style="{StaticResource StandardGroupBoxStyle}">
                        <StackPanel Margin="10">
                            <TextBlock Text="{loc:Tr Label_BurgundyBase}" FontWeight="Bold" Margin="0,10,0,5"/>
                            <DataGrid Style="{StaticResource StandardDataGridStyle}" Height="220"
                                      AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                      ItemsSource="{Binding BurgundyColors}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{loc:Tr Col_Color}" Width="100" Binding="{Binding ColorHex}"/>
                                    <DataGridTextColumn Header="{loc:Tr Col_RGB}" Width="150" Binding="{Binding RGB}"/>
                                    <DataGridTextColumn Header="{loc:Tr Col_Title}" Width="*" Binding="{Binding Name}"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <TextBlock Text="{loc:Tr Label_BlueAccent}" FontWeight="Bold" Margin="0,10,0,5"/>
                            <DataGrid Style="{StaticResource StandardDataGridStyle}" Height="220"
                                      AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                      ItemsSource="{Binding BlueColors}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{loc:Tr Col_Color}" Width="100" Binding="{Binding ColorHex}"/>
                                    <DataGridTextColumn Header="{loc:Tr Col_RGB}" Width="150" Binding="{Binding RGB}"/>
                                    <DataGridTextColumn Header="{loc:Tr Col_Title}" Width="*" Binding="{Binding Name}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </GroupBox>

                </StackPanel>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="{loc:Tr Tab_Controls}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="10">

                    <Expander Header="{loc:Tr Exp_Buttons}" IsExpanded="True" Margin="0,0,0,10">
                        <StackPanel Margin="10" Orientation="Horizontal">
                            <Button Content="Primary"  Width="120" Style="{StaticResource PrimaryButtonStyle}"/>
                            <Button Content="Success"  Width="120" Style="{StaticResource SuccessButtonStyle}"/>
                            <Button Content="Danger"   Width="120" Style="{StaticResource DangerButtonStyle}"/>
                            <Button Content="Disabled" Width="120" IsEnabled="False"
                                    Style="{StaticResource PrimaryButtonStyle}"/>
                        </StackPanel>
                    </Expander>

                    <Expander Header="{loc:Tr Exp_TextFields}" IsExpanded="True" Margin="0,0,0,10">
                        <StackPanel Margin="10" Width="350" HorizontalAlignment="Left">
                            <TextBox Text="TextBox со стилем из библиотеки" Tag="{loc:Tr Demo_TextBox1}"
                                     Style="{Binding Tag, RelativeSource={RelativeSource Self}, Mode=OneWay}"/>
                            <TextBox Text="Кликни: триггер IsFocused подсветит границу" Tag="{loc:Tr Demo_TextBox2}"
                                     Style="{Binding Tag, RelativeSource={RelativeSource Self}, Mode=OneWay}"/>
                            <PasswordBox Password="12345" Margin="0,5" Padding="5"/>
                            <RichTextBox Height="60" Margin="0,5">
                                <FlowDocument>
                                    <Paragraph>RichTextBox — форматированный текст</Paragraph>
                                </FlowDocument>
                            </RichTextBox>
                        </StackPanel>
                    </Expander>

                    <Expander Header="{loc:Tr Exp_TextElements}" IsExpanded="True" Margin="0,0,0,10">
                        <StackPanel Margin="10">
                            <Label Content="{loc:Tr Header1}" FontSize="24" FontWeight="Bold"/>
                            <Label Content="{loc:Tr Header2}" FontSize="20" FontWeight="Bold"/>
                            <Label Content="{loc:Tr Header3}" FontSize="16" FontWeight="Bold"/>
                            <TextBlock Text="{loc:Tr Text_Normal}" Margin="0,5"/>
                            <TextBlock Text="{loc:Tr Text_Small}" FontSize="10" Foreground="{StaticResource DisabledColorBrush}" Margin="0,5"/>
                        </StackPanel>
                    </Expander>

                    <Expander Header="{loc:Tr Exp_ListsTables}" IsExpanded="False" Margin="0,0,0,10">
                        <StackPanel Margin="10">
                            <ListBox Width="220" Height="90" HorizontalAlignment="Left" Margin="0,5">
                                <ListBoxItem Content="{loc:Tr List_Item1}"/>
                                <ListBoxItem Content="{loc:Tr List_Item2}"/>
                                <ListBoxItem Content="{loc:Tr List_Item3}"/>
                            </ListBox>
                            <TreeView Width="220" Height="90" HorizontalAlignment="Left" Margin="0,5">
                                <TreeViewItem Header="{loc:Tr Tree_Root}">
                                    <TreeViewItem Header="{loc:Tr Tree_Child1}"/>
                                    <TreeViewItem Header="{loc:Tr Tree_Child2}"/>
                                </TreeViewItem>
                            </TreeView>
                            <DataGrid Width="320" Height="100" HorizontalAlignment="Left" Margin="0,5"
                                      Style="{StaticResource StandardDataGridStyle}"
                                      AutoGenerateColumns="False" CanUserAddRows="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{loc:Tr Col_Name}" Width="*"/>
                                    <DataGridTextColumn Header="{loc:Tr Col_Value}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Expander>

                    <Expander Header="{loc:Tr Exp_ProgressTips}" IsExpanded="False" Margin="0,0,0,10">
                        <StackPanel Margin="10">
                            <ProgressBar Height="20" Width="300" HorizontalAlignment="Left"
                                         Margin="0,5" IsIndeterminate="True"/>
                            <Button Content="{loc:Tr Btn_HoverMe}" Width="200" HorizontalAlignment="Left"
                                    Margin="0,5" Style="{StaticResource PrimaryButtonStyle}"
                                    ToolTip="{loc:Tr Tip_Button}"/>
                            <TextBlock Text="{loc:Tr Text_WithTip}" Margin="0,5"
                                       ToolTip="{loc:Tr Tip_Text}"/>
                        </StackPanel>
                    </Expander>

                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="{loc:Tr Tab_Containers}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="10">
                    <GroupBox Header="{loc:Tr Group_StackPanel}" Margin="0,0,0,10">
                        <StackPanel Margin="10">
                            <Rectangle Fill="Red" Width="100" Height="30" Margin="5"/>
                            <Rectangle Fill="Green" Width="100" Height="30" Margin="5"/>
                            <Rectangle Fill="Blue" Width="100" Height="30" Margin="5"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="{loc:Tr Group_WrapPanel}" Margin="0,0,0,10">
                        <WrapPanel Margin="10">
                            <Rectangle Fill="Red" Width="100" Height="30" Margin="5"/>
                            <Rectangle Fill="Green" Width="100" Height="30" Margin="5"/>
                            <Rectangle Fill="Blue" Width="100" Height="30" Margin="5"/>
                            <Rectangle Fill="Yellow" Width="100" Height="30" Margin="5"/>
                            <Rectangle Fill="Purple" Width="100" Height="30" Margin="5"/>
                        </WrapPanel>
                    </GroupBox>

                    <GroupBox Header="{loc:Tr Group_Grid}" Margin="0,0,0,10">
                        <Grid Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Rectangle Fill="Red" Grid.Row="0" Grid.Column="0" Height="50" Margin="5"/>
                            <Rectangle Fill="Green" Grid.Row="0" Grid.Column="1" Height="50" Margin="5"/>
                            <Rectangle Fill="Blue" Grid.Row="1" Grid.Column="0" Height="50" Margin="5"/>
                            <Rectangle Fill="Yellow" Grid.Row="1" Grid.Column="1" Height="50" Margin="5"/>
                        </Grid>
                    </GroupBox>

                    <GroupBox Header="{loc:Tr Group_DockPanel}" Margin="0,0,0,10">
                        <DockPanel Margin="10" Height="200">
                            <Rectangle Fill="Red" DockPanel.Dock="Top" Height="40" Margin="5"/>
                            <Rectangle Fill="Green" DockPanel.Dock="Left" Width="80" Margin="5"/>
                            <Rectangle Fill="Blue" DockPanel.Dock="Right" Width="80" Margin="5"/>
                            <Rectangle Fill="Yellow" Margin="5"/>
                        </DockPanel>
                    </GroupBox>

                    <GroupBox Header="{loc:Tr Group_Canvas}" Margin="0,0,0,10">
                        <Canvas Margin="10" Height="200">
                            <Rectangle Fill="Red" Canvas.Left="10" Canvas.Top="10" Width="100" Height="50"/>
                            <Rectangle Fill="Green" Canvas.Left="150" Canvas.Top="30" Width="100" Height="50"/>
                            <Rectangle Fill="Blue" Canvas.Left="80" Canvas.Top="120" Width="100" Height="50"/>
                        </Canvas>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="{loc:Tr Tab_Data}">
            <StackPanel Margin="10">

                <ToolBar Margin="0,0,0,10">
                    <Button Command="ApplicationCommands.New" CommandTarget="{Binding RelativeSource={RelativeSource AncestorType=Window}}" Content="{loc:Tr Btn_Add}" Style="{StaticResource SuccessButtonStyle}"/>
                    <Button Command="ApplicationCommands.Properties" CommandTarget="{Binding RelativeSource={RelativeSource AncestorType=Window}}" Content="{loc:Tr Btn_Edit}"   Style="{StaticResource PrimaryButtonStyle}"/>
                    <Button Command="ApplicationCommands.Delete" CommandTarget="{Binding RelativeSource={RelativeSource AncestorType=Window}}" Content="{loc:Tr Btn_Delete}" Style="{StaticResource DangerButtonStyle}"/>
                    <Separator/>
                    <Button Command="ApplicationCommands.Copy" CommandTarget="{Binding RelativeSource={RelativeSource AncestorType=Window}}" Content="{loc:Tr Btn_Copy}"   Style="{StaticResource PrimaryButtonStyle}"/>
                    <Button Command="ApplicationCommands.Paste" CommandTarget="{Binding RelativeSource={RelativeSource AncestorType=Window}}" Content="{loc:Tr Btn_Paste}"  Style="{StaticResource PrimaryButtonStyle}"/>
                </ToolBar>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <GroupBox Grid.Column="0" Header="{loc:Tr Group_SourceTable}" Margin="0,0,5,0"
                              Style="{StaticResource StandardGroupBoxStyle}">
                        <DataGrid x:Name="SourceGrid" Style="{StaticResource StandardDataGridStyle}" ItemsSource="{Binding SourceTable}" SelectedItem="{Binding SelectedSourceItem, Mode=TwoWay}"
                                  AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{loc:Tr Col_Name}" Width="*" Binding="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <DataGridTextColumn Header="{loc:Tr Col_Value}" Width="*" Binding="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>


                    <GroupBox Grid.Column="2" Header="{loc:Tr Group_TargetTable}" Margin="5,0,0,0"
                              Style="{StaticResource StandardGroupBoxStyle}">
                        <DataGrid  x:Name="TargetGrid" Style="{StaticResource StandardDataGridStyle}" ItemsSource="{Binding TargetTable}"
                                  AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{loc:Tr Col_Name}" Width="*" Binding="{Binding Name}"/>
                                <DataGridTextColumn Header="{loc:Tr Col_Value}" Width="*" Binding="{Binding Value}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>
                </Grid>

            </StackPanel>
        </TabItem>

        <TabItem Header="{loc:Tr Tab_Bindings}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20">
                    <TextBlock Text="{loc:Tr Bindings_Title}" FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Tr Binding_OneWay}" VerticalAlignment="Center" Margin="5"/>
                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="5">
                            <TextBlock Text="{loc:Tr Label_FontSize}" FontSize="16" Foreground="{StaticResource PrimaryColorBrush}"/>
                            <TextBlock Text="{Binding FontSize, Mode=OneWay}" FontSize="16" Foreground="{StaticResource PrimaryColorBrush}"/>
                        </StackPanel>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="TwoWay + PropertyChanged:" VerticalAlignment="Center" Margin="5"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SelectedTheme,  Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource StandardTextBoxStyle}" Margin="5"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="TwoWay + LostFocus (по умолчанию):" VerticalAlignment="Center" Margin="5"/>
                        <TextBox Grid.Row="2" Grid.Column="1"
                                 Text="{Binding SelectedTheme, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                 Style="{StaticResource StandardTextBoxStyle}" Margin="5"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:Tr Binding_OneWayToSource}"
                                   VerticalAlignment="Center" Margin="5"/>
                        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
                            <TextBox Width="260" Text="{Binding SourceOnlyText, Mode=OneWayToSource, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource StandardTextBoxStyle}" Margin="5"/>
                            <TextBlock Text="{loc:Tr Binding_Received}" VerticalAlignment="Center" Margin="5,0,0,0" Foreground="{StaticResource InfoColorBrush}"/>
                            <TextBlock Text="{Binding SourceOnlyText}" VerticalAlignment="Center" Margin="3,0,0,0" Foreground="{StaticResource InfoColorBrush}"/>
                        </StackPanel>


                        <TextBlock Grid.Row="4" Grid.Column="0" Text="{loc:Tr Binding_OneTime}"
                                   VerticalAlignment="Center" Margin="5"/>
                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding SelectedTheme, Mode=OneTime}" Style="{StaticResource StandardTextBoxStyle}" Margin="5"/>
                    </Grid>

                    <GroupBox Header="{loc:Tr Group_BindingResult}" Margin="0,20,0,0" Style="{StaticResource StandardGroupBoxStyle}">
                        <StackPanel>
                            <TextBlock Text="{loc:Tr Label_CurrentValue}" FontWeight="Bold"/>
                            <TextBlock Text="{Binding SelectedTheme, Converter={loc:TrTextIdConverter TextIdStringFormat='Theme_{0}'}}" FontSize="20" Foreground="{StaticResource SuccessColorBrush}" Margin="0,5,0,0"/>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</Window>
