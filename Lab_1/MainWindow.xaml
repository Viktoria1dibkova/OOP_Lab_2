<Window x:Class="Lab_1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Library;assembly=Library"
        mc:Ignorable="d"
        Title="Interface" Height="450" Width="800" >
    <TabControl Margin="10" FontSize="16">
        <TabItem Header="Основное">
            <StackPanel Margin="10">
                <GroupBox Header="Настройки персонализации" Margin="0,10">
                    <StackPanel Margin="5">
                        <ComboBox Margin="0,5" SelectedIndex="0">
                            <ComboBoxItem Content="Светлая тема"/>
                            <ComboBoxItem Content="Темная тема"/>
                        </ComboBox>
                        <ComboBox Margin="0,5" SelectedIndex="0">
                            <ComboBoxItem Content="Русский"/>
                            <ComboBoxItem Content="English"/>
                            <ComboBoxItem Content="한국어"/>
                        </ComboBox>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Настройки шрифтов" Margin="0,10">
                    <StackPanel Margin="5">
                        <ComboBox Margin="0,5" SelectedIndex="0">
                            <ComboBoxItem Content="Arial"/>
                            <ComboBoxItem Content="Times New Roman"/>
                            <ComboBoxItem Content="Segoe UI"/>
                        </ComboBox>
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <TextBlock Text="Размер шрифта: " VerticalAlignment="Center"/>
                            <Slider Width="200" Minimum="8" Maximum="32" Value="14" 
                            TickFrequency="1" IsSnapToTickEnabled="True"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </TabItem>
        
        <TabItem Header="Цветовая палитра">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="10" >
                    <GroupBox Header="Текущая тема" Margin="0,0,0,10" FontSize="12">
                        <TextBlock Text="Светлая тема" FontSize="14" FontWeight="Bold" Margin="10"/>
                    </GroupBox>

                    <GroupBox Header="Основные цвета" Margin="0,0,0,10" FontSize="12">
                        <StackPanel Margin="10">
                            <StackPanel Orientation="Horizontal" Margin="0,5">
                                <Rectangle Width="30" Height="30" Fill="#741515" Margin="0,0,10,0"/>
                                <TextBlock Text="Основной цвет" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,5">
                                <Rectangle Width="30" Height="30" Fill="#29228c" Margin="0,0,10,0"/>
                                <TextBlock Text="Акцентный цвет" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Индикаторные цвета" Margin="0,0,0,10" FontSize="12">
                        <StackPanel Margin="10">
                            <StackPanel Orientation="Horizontal" Margin="0,5">
                                <Rectangle Width="30" Height="30" Fill="#107C10" Margin="0,0,10,0"/>
                                <TextBlock Text="Успех" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,5">
                                <Rectangle Width="30" Height="30" Fill="#D13438" Margin="0,0,10,0"/>
                                <TextBlock Text="Ошибка" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,5">
                                <Rectangle Width="30" Height="30" Fill="#0078D4" Margin="0,0,10,0"/>
                                <TextBlock Text="Информация" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Таблица оттенков" Margin="0,0,0,10" >
                        <StackPanel Margin="10">
                            <TextBlock Text="Основной цвет (бордовый)" FontWeight="Bold" Margin="0,10,0,5"/>
                            <DataGrid AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" Margin="0,0,0,15">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Цвет" Width="100" Binding="{Binding ColorHex}"/>
                                    <DataGridTextColumn Header="RGB код" Width="150" Binding="{Binding RGB}"/>
                                    <DataGridTextColumn Header="Наименование" Width="200" Binding="{Binding Name}"/>
                                </DataGrid.Columns>
                                <DataGrid.ItemsSource>
                                    <x:Array Type="{x:Type local:ColorItem}">
                                        <local:ColorItem ColorHex="#FFF0E6E6" RGB="240, 230, 230" Name="Очень светлый бордовый" />
                                        <local:ColorItem ColorHex="#FFE1CCCC" RGB="225, 204, 204" Name="Светлый бордовый" />
                                        <local:ColorItem ColorHex="#FFC29999" RGB="194, 153, 153" Name="Светло-бордовый" />
                                        <local:ColorItem ColorHex="#FFA36666" RGB="163, 102, 102" Name="Бордовый светлый" />
                                        <local:ColorItem ColorHex="#FF803333" RGB="128, 51, 51" Name="Бордовый" />
                                        <local:ColorItem ColorHex="#FF800000" RGB="128, 0, 0" Name="Основной бордовый" />
                                        <local:ColorItem ColorHex="#FF660000" RGB="102, 0, 0" Name="Тёмно-бордовый" />
                                        <local:ColorItem ColorHex="#FF4D0000" RGB="77, 0, 0" Name="Очень тёмный бордовый" />
                                        <local:ColorItem ColorHex="#FF330000" RGB="51, 0, 0" Name="Почти чёрный бордовый" />
                                        <local:ColorItem ColorHex="#FF1A0000" RGB="26, 0, 0" Name="Чёрный бордовый" />
                                    </x:Array>
                                </DataGrid.ItemsSource>
                            </DataGrid>

                            <TextBlock Text="Акцентный цвет (синий)" FontWeight="Bold" Margin="0,0,0,5"/>
                            <DataGrid AutoGenerateColumns="False" CanUserAddRows="False" Margin="0,0,0,15">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Цвет" Width="100" Binding="{Binding ColorHex}"/>
                                    <DataGridTextColumn Header="RGB код" Width="150" Binding="{Binding RGB}"/>
                                    <DataGridTextColumn Header="Наименование" Width="200" Binding="{Binding Name}"/>
                                </DataGrid.Columns>
                                <DataGrid.ItemsSource>
                                    <x:Array Type="{x:Type local:ColorItem}">
                                        <local:ColorItem ColorHex="#E6F2FF" RGB="230, 242, 255" Name="Очень светлый синий" />
                                        <local:ColorItem ColorHex="#CCE5FF" RGB="204, 229, 255" Name="Светлый синий" />
                                        <local:ColorItem ColorHex="#99CCFF" RGB="153, 204, 255" Name="Светло-синий" />
                                        <local:ColorItem ColorHex="#66B2FF" RGB="102, 178, 255" Name="Голубой" />
                                        <local:ColorItem ColorHex="#3399FF" RGB="51, 153, 255" Name="Синий" />
                                        <local:ColorItem ColorHex="#0078D4" RGB="0, 120, 212" Name="Основной синий" />
                                        <local:ColorItem ColorHex="#0063B1" RGB="0, 99, 177" Name="Темно-синий" />
                                        <local:ColorItem ColorHex="#004C8C" RGB="0, 76, 140" Name="Очень темный синий" />
                                        <local:ColorItem ColorHex="#003666" RGB="0, 54, 102" Name="Почти черный синий" />
                                        <local:ColorItem ColorHex="#001F40" RGB="0, 31, 64" Name="Черный синий" />
                                    </x:Array>
                                </DataGrid.ItemsSource>
                            </DataGrid>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="Элементы управления">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="10" >
                    <Expander Header="Кнопки" IsExpanded="True" Margin="0,0,0,10">
                        <StackPanel Margin="10">
                            <Button Content="Обычная кнопка" Margin="0,5" Width="200" HorizontalAlignment="Left"/>
                            <Button Margin="0,5" Width="200" HorizontalAlignment="Left">
                                <Button.Content>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="★" FontSize="16" Margin="0,0,5,0"/>
                                        <TextBlock Text="С иконкой"/>
                                    </StackPanel>
                                </Button.Content>
                            </Button>
                            <ToggleButton Content="Переключатель" Margin="0,5" Width="200" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Expander>

                    <Expander Header="Текстовые поля" IsExpanded="True" Margin="0,0,0,10">
                        <StackPanel Margin="10">
                            <TextBox Text="TextBox - обычное текстовое поле" Margin="0,5" Width="300" HorizontalAlignment="Left"/>
                            <PasswordBox Password="12345" Margin="0,5" Width="300" HorizontalAlignment="Left"/>
                            <RichTextBox Width="300" Height="60" HorizontalAlignment="Left" Margin="0,5">
                                <FlowDocument>
                                    <Paragraph>RichTextBox - форматированный текст</Paragraph>
                                </FlowDocument>
                            </RichTextBox>
                        </StackPanel>
                    </Expander>

                    <Expander Header="Текстовые элементы" IsExpanded="True" Margin="0,0,0,10">
                        <StackPanel Margin="10">
                            <Label Content="Заголовок 1" FontSize="24" FontWeight="Bold" Margin="0,5"/>
                            <Label Content="Заголовок 2" FontSize="20" FontWeight="Bold" Margin="0,5"/>
                            <Label Content="Заголовок 3" FontSize="16" FontWeight="Bold" Margin="0,5"/>
                            <TextBlock Text="Обычный текст" Margin="0,5"/>
                            <TextBlock Text="Подпись (мелкий текст)" FontSize="10" Foreground="Gray" Margin="0,5"/>
                        </StackPanel>
                    </Expander>

                    <Expander Header="Списки и таблицы" IsExpanded="True" Margin="0,0,0,10">
                        <StackPanel Margin="10">
                            <ListBox Width="200" Height="100" HorizontalAlignment="Left" Margin="0,5">
                                <ListBoxItem Content="Элемент 1"/>
                                <ListBoxItem Content="Элемент 2"/>
                                <ListBoxItem Content="Элемент 3"/>
                            </ListBox>
                            <TreeView Width="200" Height="100" HorizontalAlignment="Left" Margin="0,5">
                                <TreeViewItem Header="Корень">
                                    <TreeViewItem Header="Дочерний 1"/>
                                    <TreeViewItem Header="Дочерний 2"/>
                                </TreeViewItem>
                            </TreeView>
                            <DataGrid Width="300" Height="100" HorizontalAlignment="Left" Margin="0,5" AutoGenerateColumns="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Имя" Width="150"/>
                                    <DataGridTextColumn Header="Значение" Width="150"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Expander>

                    <Expander Header="Прогресс-бар" IsExpanded="True" Margin="0,0,0,10">
                        <StackPanel Margin="10">
                            <ProgressBar  Height="20" Width="300" HorizontalAlignment="Left" Margin="0,5" IsIndeterminate="True"/>
                        </StackPanel>
                    </Expander>

                    <Expander Header="Всплывающие подсказки" IsExpanded="True" Margin="0,0,0,10">
                        <StackPanel Margin="10">
                            <Button Content="Наведи на меня" Width="200" HorizontalAlignment="Left" Margin="0,5"
                            ToolTip="Это всплывающая подсказка!"/>
                            <TextBlock Text="Текст с подсказкой" Margin="0,5"
                               ToolTip="Подсказка для текста"/>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="Контейнеры компоновки">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="10">
                    <GroupBox Header="StackPanel - элементы располагаются вертикально или горизонтально" Margin="0,0,0,10">
                        <StackPanel Margin="10">
                            <Rectangle Fill="Red" Width="100" Height="30" Margin="5"/>
                            <Rectangle Fill="Green" Width="100" Height="30" Margin="5"/>
                            <Rectangle Fill="Blue" Width="100" Height="30" Margin="5"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="WrapPanel - элементы переносятся на новую строку" Margin="0,0,0,10">
                        <WrapPanel Margin="10">
                            <Rectangle Fill="Red" Width="100" Height="30" Margin="5"/>
                            <Rectangle Fill="Green" Width="100" Height="30" Margin="5"/>
                            <Rectangle Fill="Blue" Width="100" Height="30" Margin="5"/>
                            <Rectangle Fill="Yellow" Width="100" Height="30" Margin="5"/>
                            <Rectangle Fill="Purple" Width="100" Height="30" Margin="5"/>
                        </WrapPanel>
                    </GroupBox>

                    <GroupBox Header="Grid - элементы располагаются по сетке" Margin="0,0,0,10">
                        <Grid Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Rectangle Fill="Red" Grid.Row="0" Grid.Column="0" Height="50" Margin="5"/>
                            <Rectangle Fill="Green" Grid.Row="0" Grid.Column="1" Height="50" Margin="5"/>
                            <Rectangle Fill="Blue" Grid.Row="1" Grid.Column="0" Height="50" Margin="5"/>
                            <Rectangle Fill="Yellow" Grid.Row="1" Grid.Column="1" Height="50" Margin="5"/>
                        </Grid>
                    </GroupBox>

                    <GroupBox Header="DockPanel - элементы прижимаются к краям" Margin="0,0,0,10">
                        <DockPanel Margin="10" Height="200">
                            <Rectangle Fill="Red" DockPanel.Dock="Top" Height="40" Margin="5"/>
                            <Rectangle Fill="Green" DockPanel.Dock="Left" Width="80" Margin="5"/>
                            <Rectangle Fill="Blue" DockPanel.Dock="Right" Width="80" Margin="5"/>
                            <Rectangle Fill="Yellow" Margin="5"/>
                        </DockPanel>
                    </GroupBox>

                    <GroupBox Header="Canvas - абсолютное позиционирование" Margin="0,0,0,10">
                        <Canvas Margin="10" Height="200">
                            <Rectangle Fill="Red" Canvas.Left="10" Canvas.Top="10" Width="100" Height="50"/>
                            <Rectangle Fill="Green" Canvas.Left="150" Canvas.Top="30" Width="100" Height="50"/>
                            <Rectangle Fill="Blue" Canvas.Left="80" Canvas.Top="120" Width="100" Height="50"/>
                        </Canvas>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</Window>
